<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ApoioSus.ViewModels"
             xmlns:conv="clr-namespace:ApoioSus.Converters"
             x:Class="ApoioSus.Views.RedefinirSenhaPage"
             x:DataType="vm:RedefinirSenhaViewModel"
             Title="Nova senha">

	<ContentPage.Resources>
		<conv:TemTextoConverter x:Key="TemTexto" />
		<Style x:Key="Erro" TargetType="Label">
			<Setter Property="TextColor" Value="#C62828" />
			<Setter Property="FontSize" Value="12" />
		</Style>
	</ContentPage.Resources>

	<ScrollView>
		<VerticalStackLayout Padding="24" Spacing="6" MaximumWidthRequest="480">

			<Label Text="Digite o código recebido e escolha uma nova senha." Margin="0,0,0,12" />

			<Label Text="Código" />
			<Entry Text="{Binding Codigo}" Placeholder="XXXX-XXXX-XXXX" MaxLength="20" />
			<Label Text="{Binding CodigoErro}" Style="{StaticResource Erro}"
			       IsVisible="{Binding CodigoErro, Converter={StaticResource TemTexto}}" />

			<Label Text="Nova senha (mínimo 8 caracteres)" Margin="0,8,0,0" />
			<Entry Text="{Binding NovaSenha}" IsPassword="True" MaxLength="72" />
			<Label Text="{Binding NovaSenhaErro}" Style="{StaticResource Erro}"
			       IsVisible="{Binding NovaSenhaErro, Converter={StaticResource TemTexto}}" />

			<Label Text="Confirmar nova senha" Margin="0,8,0,0" />
			<Entry Text="{Binding ConfirmarSenha}" IsPassword="True" MaxLength="72" />
			<Label Text="{Binding ConfirmarSenhaErro}" Style="{StaticResource Erro}"
			       IsVisible="{Binding ConfirmarSenhaErro, Converter={StaticResource TemTexto}}" />

			<Label Text="{Binding ErroGeral}" Style="{StaticResource Erro}" FontSize="14" Margin="0,8,0,0"
			       IsVisible="{Binding ErroGeral, Converter={StaticResource TemTexto}}" />

			<Button Text="Salvar nova senha" Command="{Binding SalvarCommand}" Margin="0,16,0,0" />
			<ActivityIndicator IsRunning="{Binding Carregando}" IsVisible="{Binding Carregando}" />
			<Button Text="Voltar" Command="{Binding VoltarCommand}" BackgroundColor="Transparent" TextColor="Gray" />
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
