<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ApoioSus.ViewModels"
             xmlns:conv="clr-namespace:ApoioSus.Converters"
             x:Class="ApoioSus.Views.ContaPage"
             x:DataType="vm:ContaViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FundoClaro}, Dark={StaticResource OffBlack}}"
             Title="Minha conta">

	<ContentPage.Resources>
		<conv:TemTextoConverter x:Key="TemTexto" />
		<Style x:Key="Erro" TargetType="Label">
			<Setter Property="TextColor" Value="#C62828" />
			<Setter Property="FontSize" Value="12" />
		</Style>
		<Style x:Key="Rotulo" TargetType="Label">
			<Setter Property="FontSize" Value="15" />
			<Setter Property="FontAttributes" Value="Bold" />
			<Setter Property="Margin" Value="0,10,0,0" />
		</Style>

		<!-- Campo com cantos arredondados e borda clara, no mesmo estilo dos demais formulários. -->
		<Style x:Key="Campo" TargetType="Border">
			<Setter Property="StrokeShape" Value="RoundRectangle 14" />
			<Setter Property="Stroke" Value="{StaticResource LinhaClara}" />
			<Setter Property="StrokeThickness" Value="1" />
			<Setter Property="Padding" Value="14,0" />
			<Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}" />
		</Style>
	</ContentPage.Resources>

	<ScrollView>
		<VerticalStackLayout Padding="20,16,20,24" Spacing="6" MaximumWidthRequest="480">

			<!-- Cabeçalho: voltar e título centralizado -->
			<Grid ColumnDefinitions="48,*,48">
				<Label Grid.Column="0" Text="‹" FontSize="34" VerticalOptions="Center" HorizontalOptions="Start"
				       AutomationId="Voltar">
					<Label.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding VoltarCommand}" />
					</Label.GestureRecognizers>
				</Label>
				<Label Grid.Column="1" Text="Minha conta" FontSize="18" FontAttributes="Bold"
				       HorizontalOptions="Center" VerticalOptions="Center" />
			</Grid>

			<!-- E-mail: identifica a conta e não pode ser alterado -->
			<Label Text="E-mail" Style="{StaticResource Rotulo}" />
			<Border Style="{StaticResource Campo}" Padding="14,14"
			        BackgroundColor="{AppThemeBinding Light=#EEF2F7, Dark={StaticResource Gray950}}">
				<Grid ColumnDefinitions="24,*" ColumnSpacing="12">
					<Image Grid.Column="0" Source="ic_email.png" WidthRequest="22" HeightRequest="22" />
					<Label Grid.Column="1" Text="{Binding Email}" FontSize="16" VerticalOptions="Center"
					       TextColor="{AppThemeBinding Light={StaticResource CinzaTexto}, Dark={StaticResource Gray200}}" />
				</Grid>
			</Border>
			<Label Text="O e-mail identifica a conta e não pode ser alterado." FontSize="12" TextColor="Gray" />

			<Label Text="Nome" Style="{StaticResource Rotulo}" />
			<Border Style="{StaticResource Campo}">
				<Grid ColumnDefinitions="24,*" ColumnSpacing="12">
					<Image Grid.Column="0" Source="ic_usuario.png" WidthRequest="22" HeightRequest="22" />
					<Entry Grid.Column="1" Text="{Binding Nome}" Placeholder="Nome completo" MaxLength="120"
					       AutomationId="Nome" />
				</Grid>
			</Border>
			<Label Text="{Binding NomeErro}" Style="{StaticResource Erro}"
			       IsVisible="{Binding NomeErro, Converter={StaticResource TemTexto}}" />

			<Label Text="Data de nascimento (opcional)" Style="{StaticResource Rotulo}" />
			<Border Style="{StaticResource Campo}">
				<Grid ColumnDefinitions="24,*" ColumnSpacing="12">
					<Image Grid.Column="0" Source="ic_calendario.png" WidthRequest="22" HeightRequest="22" />
					<Entry Grid.Column="1" Text="{Binding DataNascimento}" Placeholder="dd/mm/aaaa" MaxLength="10"
					       Keyboard="Numeric" AutomationId="DataNascimento" />
				</Grid>
			</Border>
			<Label Text="{Binding DataNascimentoErro}" Style="{StaticResource Erro}"
			       IsVisible="{Binding DataNascimentoErro, Converter={StaticResource TemTexto}}" />

			<Label Text="{Binding ErroGeral}" Style="{StaticResource Erro}" FontSize="14" Margin="0,8,0,0"
			       IsVisible="{Binding ErroGeral, Converter={StaticResource TemTexto}}" />
			<Label Text="{Binding Sucesso}" TextColor="Green" Margin="0,8,0,0"
			       IsVisible="{Binding Sucesso, Converter={StaticResource TemTexto}}" />

			<Button Text="Salvar" Command="{Binding SalvarCommand}" CornerRadius="14" FontAttributes="Bold"
			        HeightRequest="52" Margin="0,16,0,0" />
			<ActivityIndicator IsRunning="{Binding Carregando}" IsVisible="{Binding Carregando}" />
			<Button Text="Excluir minha conta" Command="{Binding ExcluirCommand}" BackgroundColor="Transparent"
			        TextColor="#C62828" BorderColor="#C62828" BorderWidth="1" CornerRadius="14" HeightRequest="48"
			        Margin="0,8,0,0" />
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
