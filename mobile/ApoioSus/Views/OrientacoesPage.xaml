<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ApoioSus.ViewModels"
             xmlns:conv="clr-namespace:ApoioSus.Converters"
             x:Class="ApoioSus.Views.OrientacoesPage"
             x:DataType="vm:OrientacoesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FundoClaro}, Dark={StaticResource OffBlack}}"
             Title="Orientações de saúde">

	<ContentPage.Resources>
		<conv:TemTextoConverter x:Key="TemTexto" />
		<Style x:Key="Detalhe" TargetType="Label">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CinzaTexto}, Dark={StaticResource Gray200}}" />
		</Style>
	</ContentPage.Resources>

	<Grid Padding="20,16,20,12" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12" MaximumWidthRequest="480">

		<!-- Cabeçalho: voltar e título centralizado -->
		<Grid Grid.Row="0" ColumnDefinitions="48,*,48">
			<Label Grid.Column="0" Text="‹" FontSize="34" VerticalOptions="Center" HorizontalOptions="Start"
			       AutomationId="Voltar">
				<Label.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding VoltarCommand}" />
				</Label.GestureRecognizers>
			</Label>
			<Label Grid.Column="1" Text="Orientações de saúde" FontSize="18" FontAttributes="Bold"
			       HorizontalOptions="Center" VerticalOptions="Center" />
		</Grid>

		<!-- Busca -->
		<Border Grid.Row="1" StrokeShape="RoundRectangle 14" Stroke="{StaticResource LinhaClara}" StrokeThickness="1"
		        Padding="12,0" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
			<Grid ColumnDefinitions="24,*" ColumnSpacing="10">
				<Image Grid.Column="0" Source="ic_busca.png" WidthRequest="20" HeightRequest="20" />
				<Entry Grid.Column="1" Text="{Binding Busca}" Placeholder="Buscar orientações" />
			</Grid>
		</Border>

		<!-- Chips de categoria -->
		<CollectionView Grid.Row="2" ItemsSource="{Binding Filtros}" SelectionMode="None" HeightRequest="44">
			<CollectionView.ItemsLayout>
				<LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
			</CollectionView.ItemsLayout>
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="vm:FiltroOrientacao">
					<Border StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="18,0" HeightRequest="38"
					        BackgroundColor="{AppThemeBinding Light=#E9EFF7, Dark={StaticResource Gray900}}">
						<Border.Triggers>
							<DataTrigger TargetType="Border" Binding="{Binding Selecionado}" Value="True">
								<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
							</DataTrigger>
						</Border.Triggers>
						<Border.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding Comando}" />
						</Border.GestureRecognizers>
						<Label Text="{Binding Nome}" FontAttributes="Bold" VerticalOptions="Center"
						       TextColor="{AppThemeBinding Light={StaticResource CinzaTexto}, Dark={StaticResource Gray200}}">
							<Label.Triggers>
								<DataTrigger TargetType="Label" Binding="{Binding Selecionado}" Value="True">
									<Setter Property="TextColor" Value="White" />
								</DataTrigger>
							</Label.Triggers>
						</Label>
					</Border>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<!-- Conteúdo: carregando, erro, vazio ou lista -->
		<Grid Grid.Row="3">
			<VerticalStackLayout IsVisible="{Binding Carregando}" Spacing="12" VerticalOptions="Start" Margin="0,32,0,0">
				<ActivityIndicator IsRunning="{Binding Carregando}" />
				<Label Text="Carregando orientações…" HorizontalOptions="Center" Style="{StaticResource Detalhe}" />
			</VerticalStackLayout>

			<VerticalStackLayout IsVisible="{Binding TemErro}" Spacing="12" VerticalOptions="Start" Margin="0,32,0,0">
				<Label Text="{Binding ErroGeral}" TextColor="#C62828" HorizontalTextAlignment="Center" />
				<Button Text="Tentar novamente" Command="{Binding TentarNovamenteCommand}" />
			</VerticalStackLayout>

			<Label Text="Nenhuma orientação encontrada." TextColor="Gray" HorizontalOptions="Center"
			       VerticalOptions="Start" Margin="0,32,0,0" IsVisible="{Binding SemResultado}" />

			<CollectionView ItemsSource="{Binding Orientacoes}" SelectionMode="None" IsVisible="{Binding TemOrientacoes}">
				<CollectionView.ItemsLayout>
					<LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
				</CollectionView.ItemsLayout>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="vm:OrientacaoItem">
						<Border StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="12" Margin="2,2,2,4"
						        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
							<Border.Shadow>
								<Shadow Brush="#1E6BD6" Opacity="0.10" Radius="10" Offset="0,3" />
							</Border.Shadow>
							<Grid ColumnDefinitions="76,*" ColumnSpacing="14">
								<Image Grid.Column="0" Source="{Binding Icone}" WidthRequest="76" HeightRequest="76"
								       VerticalOptions="Start" />
								<VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
									<Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="16" />
									<Label Text="{Binding Resumo}" Style="{StaticResource Detalhe}" />
								</VerticalStackLayout>
							</Grid>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</Grid>

		<Label Grid.Row="4" FontSize="11" TextColor="Gray" HorizontalTextAlignment="Center"
		       Text="Conteúdo informativo e geral. Não substitui a orientação de um profissional de saúde." />
	</Grid>
</ContentPage>
