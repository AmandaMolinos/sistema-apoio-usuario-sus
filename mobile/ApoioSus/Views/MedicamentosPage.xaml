<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ApoioSus.ViewModels"
             xmlns:conv="clr-namespace:ApoioSus.Converters"
             xmlns:views="clr-namespace:ApoioSus.Views"
             x:Class="ApoioSus.Views.MedicamentosPage"
             x:DataType="vm:MedicamentosViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FundoClaro}, Dark={StaticResource OffBlack}}"
             Title="Meus medicamentos">

	<ContentPage.Resources>
		<conv:TemTextoConverter x:Key="TemTexto" />
		<Style x:Key="Detalhe" TargetType="Label">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CinzaTexto}, Dark={StaticResource Gray200}}" />
		</Style>
		<Style x:Key="TextoAba" TargetType="Label">
			<Setter Property="HorizontalOptions" Value="Center" />
			<Setter Property="FontAttributes" Value="Bold" />
			<Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CinzaTexto}, Dark={StaticResource Gray200}}" />
		</Style>
	</ContentPage.Resources>

	<Grid RowDefinitions="*,Auto">
		<Grid Grid.Row="0" Padding="20,16,20,0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12" MaximumWidthRequest="480">

			<Grid Grid.Row="0" ColumnDefinitions="*,Auto">
				<Label Grid.Column="0" Text="Meus medicamentos" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
				<Button Grid.Column="1" Text="+ Adicionar" Command="{Binding NovoCommand}"
				        CornerRadius="12" FontAttributes="Bold" Padding="18,8" />
			</Grid>

			<!-- Abas Em uso / Histórico -->
			<Border Grid.Row="1" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="4"
			        BackgroundColor="{AppThemeBinding Light=#E9EFF7, Dark={StaticResource Gray900}}">
				<Grid ColumnDefinitions="*,*" ColumnSpacing="4">
					<Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 11" Padding="0,10"
					        BackgroundColor="Transparent">
						<Border.Triggers>
							<DataTrigger TargetType="Border" Binding="{Binding EmUso}" Value="True">
								<Setter Property="BackgroundColor" Value="#DCEBFD" />
							</DataTrigger>
						</Border.Triggers>
						<Border.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding VerEmUsoCommand}" />
						</Border.GestureRecognizers>
						<Label Text="Em uso" Style="{StaticResource TextoAba}">
							<Label.Triggers>
								<DataTrigger TargetType="Label" Binding="{Binding EmUso}" Value="True">
									<Setter Property="TextColor" Value="{StaticResource Primary}" />
								</DataTrigger>
							</Label.Triggers>
						</Label>
					</Border>
					<Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 11" Padding="0,10"
					        BackgroundColor="Transparent">
						<Border.Triggers>
							<DataTrigger TargetType="Border" Binding="{Binding Historico}" Value="True">
								<Setter Property="BackgroundColor" Value="#DCEBFD" />
							</DataTrigger>
						</Border.Triggers>
						<Border.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding VerHistoricoCommand}" />
						</Border.GestureRecognizers>
						<Label Text="Histórico" Style="{StaticResource TextoAba}">
							<Label.Triggers>
								<DataTrigger TargetType="Label" Binding="{Binding Historico}" Value="True">
									<Setter Property="TextColor" Value="{StaticResource Primary}" />
								</DataTrigger>
							</Label.Triggers>
						</Label>
					</Border>
				</Grid>
			</Border>

			<Label Grid.Row="2" Text="{Binding ErroGeral}" TextColor="#C62828"
			       IsVisible="{Binding ErroGeral, Converter={StaticResource TemTexto}}" />

			<Label Grid.Row="3" Text="Nenhum medicamento nesta lista." TextColor="Gray"
			       HorizontalOptions="Center" Margin="0,24,0,0" IsVisible="{Binding ListaVazia}" />

			<CollectionView Grid.Row="3" ItemsSource="{Binding Medicamentos}" SelectionMode="None"
			                IsVisible="{Binding TemMedicamentos}">
				<CollectionView.ItemsLayout>
					<LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
				</CollectionView.ItemsLayout>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="vm:MedicamentoItem">
						<Border StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="16,14" Margin="2,2,2,4"
						        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
							<Border.Shadow>
								<Shadow Brush="#1E6BD6" Opacity="0.10" Radius="10" Offset="0,3" />
							</Border.Shadow>
							<Border.GestureRecognizers>
								<TapGestureRecognizer Tapped="AoTocarMedicamento" />
							</Border.GestureRecognizers>
							<Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="14">
								<Image Grid.Column="0" Source="{Binding Icone}" WidthRequest="60" HeightRequest="60"
								       VerticalOptions="Center" />
								<VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
									<Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="16" />
									<Label Text="{Binding Dosagem}" Style="{StaticResource Detalhe}" IsVisible="{Binding TemDosagem}" />
									<Label Text="{Binding Frequencia}" Style="{StaticResource Detalhe}" IsVisible="{Binding TemFrequencia}" />
									<Label Text="{Binding Inicio}" Style="{StaticResource Detalhe}" IsVisible="{Binding TemInicio}" />
									<Label Text="{Binding Fim}" Style="{StaticResource Detalhe}" IsVisible="{Binding TemFim}" />
								</VerticalStackLayout>
								<Label Grid.Column="2" Text="›" FontSize="26" VerticalOptions="Center"
								       TextColor="{StaticResource CinzaIcone}" />
							</Grid>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</Grid>

		<views:BarraInferior Grid.Row="1" Atual="medicamentos" />
	</Grid>
</ContentPage>
